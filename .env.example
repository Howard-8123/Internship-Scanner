# Semicolon-separated provider|public-board-identifier|display-name entries.
# Supported providers: greenhouse, lever, ashby, smartrecruiters, workable,
# recruitee, personio.
ATS_COMPANIES=greenhouse|cloudflare|Cloudflare

REQUEST_TIMEOUT_SECONDS=10
CACHE_TTL_SECONDS=3600
CACHE_PATH=.cache/internship-scanner.json
LOG_LEVEL=INFO

# Hybrid AI pipeline. The first enabled run downloads the configured local model.
AI_ENABLED=true
AI_CACHE_PATH=.cache/intelligence.sqlite3
# Increment to invalidate all inference artifacts after a prompt/schema change.
AI_CACHE_VERSION=2
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
SEMANTIC_THRESHOLD=0.45
INTERNSHIP_MARGIN_THRESHOLD=-0.03
TECHNICAL_MARGIN_THRESHOLD=0.02
LABEL_THRESHOLD=0.45
MAX_LABELS=3
LLM_CONFIDENCE_THRESHOLD=0.65
LLM_INTERNSHIP_THRESHOLD=0.75
RECOMMENDATION_THRESHOLD=0.40

# Labels are data, not an enum: add comma-separated labels without changing code.
AI_LABELS=AI,Machine Learning,Deep Learning,LLMs,NLP,Computer Vision,Robotics,Data Engineering,Backend,Frontend,Full Stack,Cloud,Infrastructure,Security,DevOps,Embedded,Mobile,Research,General Software Engineering

# none, openai, anthropic, gemini, openrouter, or ollama.
LLM_PROVIDER=none
LLM_MODEL=
# Prefer the provider-specific key variables documented in README.md.
LLM_API_KEY=
LLM_BASE_URL=

RANKING_SEMANTIC_WEIGHT=0.35
RANKING_CONFIDENCE_WEIGHT=0.20
RANKING_AI_WEIGHT=0.20
RANKING_INTERNSHIP_WEIGHT=0.25
